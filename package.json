{
  "name": "nomina-docente-modern",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/api run lint && npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck",
    "test": "npm --workspace apps/api run test && npm --workspace apps/web run test",
    "test:api": "npm --workspace apps/api run test",
    "test:api:integration": "npm --workspace apps/api run test:integration",
    "test:db:prepare": "npm --workspace apps/api run test:db:prepare",
    "test:web": "npm --workspace apps/web run test",
    "db:migrate:status": "tsx tools/migrate-db.ts status",
    "db:migrate:dry-run": "tsx tools/migrate-db.ts dry-run",
    "db:migrate:baseline": "tsx tools/migrate-db.ts baseline",
    "db:migrate": "tsx tools/migrate-db.ts apply",
    "db:migrate:apply": "tsx tools/migrate-db.ts apply",
    "legacy:csv-to-sql": "node tools/legacy-csv-to-sql.mjs",
    "legacy:schedules-to-sql": "node tools/legacy-schedules-csv-to-sql.mjs",
    "legacy:extras-to-sql": "node tools/legacy-extras-csv-to-sql.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
